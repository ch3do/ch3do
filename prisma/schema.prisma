generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  name      String?
  companies Company[]
  createdAt DateTime  @default(now())
}

model Company {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  website        String
  logo           String?

  businessDna    BusinessDna?
  targetGroups   TargetGroup[]
  products       Product[]
  guidelines     Guideline[]
  contents       Content[]

  scrapingStatus String   @default("PENDING")
  scrapedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessDna {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  description      String?
  history          String?
  mission          String?
  vision           String?
  values           String?  // JSON string

  toneOfVoice      String?
  brandPersonality String?

  usp              String?
  competitors      String?  // JSON string
  industryKeywords String?  // JSON string

  email            String?
  phone            String?
  address          String?
  socialLinks      String?  // JSON string

  rawScrapedData   String?  // JSON string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TargetGroup {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name             String
  description      String?

  ageRange         String?
  gender           String?
  location         String?
  income           String?
  education        String?
  occupation       String?

  interests        String?  // JSON string
  painPoints       String?  // JSON string
  goals            String?  // JSON string
  behaviors        String?  // JSON string

  buyingMotivation String?
  objections       String?  // JSON string

  contents         Content[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  category         String?

  features         String?  // JSON string
  benefits         String?  // JSON string
  price            String?
  imageUrl         String?
  images           String?  // JSON string array of image URLs

  targetAudience   String?
  differentiators  String?  // JSON string

  contents         Content[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guideline {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name             String
  type             String
  description      String?

  promptTemplate   String

  minLength        Int?
  maxLength        Int?
  requiredElements String?  // JSON string
  avoidElements    String?  // JSON string

  style            String?
  format           String?

  contents         Content[]

  isDefault        Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  targetGroupId String?
  targetGroup   TargetGroup? @relation(fields: [targetGroupId], references: [id])

  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])

  guidelineId   String?
  guideline     Guideline?   @relation(fields: [guidelineId], references: [id])

  title         String
  topic         String?
  body          String

  imageUrl      String?
  imagePrompt   String?

  type          String
  status        String    @default("DRAFT")

  generationContext String?  // JSON string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String

  operation String  // "scraping", "content_generation", "image_generation"
  model     String  // "gemini-2.0-flash", "nanobanana", etc.

  inputTokens  Int
  outputTokens Int

  costUsd      Float  // Cost in USD

  companyId    String?
  contentId    String?

  metadata     String?  // JSON string with additional data

  createdAt DateTime @default(now())
}
